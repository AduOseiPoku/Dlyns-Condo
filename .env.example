# =====================================================================
# Dlyns Condo — Environment Configuration
# =====================================================================

# 1. Django Security Settings
# Generate a secret key or use a strong random string in Dokploy
SECRET_KEY=replace-with-a-very-long-random-secret-key
DEBUG=False

# 2. Host & Domain Routing (Comma-separated)
# In Dokploy, include your custom domain and Dokploy preview host
ALLOWED_HOSTS=dlynscondo.com,www.dlynscondo.com,*.dokploy.host,localhost,127.0.0.1

# 3. CSRF Trusted Origins (Comma-separated)
# Required for form submissions over HTTPS (e.g., Traefik SSL)
CSRF_TRUSTED_ORIGINS=https://dlynscondo.com,https://www.dlynscondo.com,https://*.dokploy.host

# 4. Production Database (PostgreSQL)
# Dokploy allows 1-click Postgres. Paste the connection string here:
# DATABASE_URL=postgres://user:password@postgres-service:5432/dlyns_condo_db

# 5. Optional Automatic Superuser (Created on first boot)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=ChangeThisPassword123!
# DJANGO_SUPERUSER_EMAIL=admin@dlynscondo.com

# 6. Gunicorn Performance (Optional)
# GUNICORN_WORKERS=3
# PORT=8000
